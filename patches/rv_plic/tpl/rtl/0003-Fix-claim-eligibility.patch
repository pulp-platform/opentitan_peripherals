From: ZhaoWenyao <109258098+lionelZhaowy@users.noreply.github.com>
Subject: [PATCH] Use live eligible PLIC claims

--- a/rv_plic.sv.tpl
+++ b/rv_plic.sv.tpl
@@ -70,12 +70,13 @@
   logic [PRIOW-1:0] threshold [NumTarget];
 
   // Glue logic between ${module_instance_name}_reg_top and others
-  assign cc_id = irq_id_o;
+  assign cc_id = claim_id;
 
   always_comb begin
     claim = '0;
     for (int i = 0 ; i < NumTarget ; i++) begin
-      if (claim_re[i]) claim[claim_id[i]] = 1'b1;
+      if (claim_re[i] && (claim_id[i] != '0) && (int'(claim_id[i]) < NumSrc))
+        claim[claim_id[i]] = 1'b1;
     end
   end
   always_comb begin
@@ -120,7 +121,6 @@
   /////////////////
 % for t in range(target):
   assign claim_re[${t}]    = reg2hw.cc${t}.re;
-  assign claim_id[${t}]    = irq_id_o[${t}];
   assign complete_we[${t}] = reg2hw.cc${t}.qe;
   assign complete_id[${t}] = reg2hw.cc${t}.q;
   assign hw2reg.cc${t}.d   = cc_id[${t}];
@@ -193,7 +193,8 @@
       .threshold_i (threshold[i]),
 
       .irq_o       (irq_o[i]),
-      .irq_id_o    (irq_id_o[i])
+      .irq_id_o    (irq_id_o[i]),
+      .claim_id_o  (claim_id[i])
 
     );
   end
--- a/rv_plic_target.sv.tpl
+++ b/rv_plic_target.sv.tpl
@@ -32,7 +32,8 @@
   input               [PrioWidth-1:0] threshold_i,
 
   output logic                irq_o,
-  output logic [SrcWidth-1:0] irq_id_o
+  output logic [SrcWidth-1:0] irq_id_o,
+  output logic [SrcWidth-1:0] claim_id_o
 );
 
   // Find maximum value and index using a binary tree implementation.
@@ -57,6 +58,8 @@
 
   assign irq_d    = (max_value > threshold_i) ? max_valid : 1'b0;
   assign irq_id_d = (max_valid) ? max_idx : '0;
+  // Priority zero disables a source; threshold gates only notification.
+  assign claim_id_o = (max_valid && (max_value != '0)) ? max_idx : '0;
 
   always_ff @(posedge clk_i or negedge rst_ni) begin : gen_regs
     if (!rst_ni) begin
